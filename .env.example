# Rapid Lifeline — Environment Variables Template (.env.example)
# Use synthetic dummy credentials only for local development. Never commit real secrets.

PORT=3000
APP_ENV=local
NODE_ENV=development

# Database and Cache
DATABASE_URL=postgresql://rapidlifeline:rapidlifeline@localhost:5432/rapidlifeline
REDIS_URL=redis://localhost:6379

# Authentication (64-byte random strings for HMAC SHA-256)
JWT_ACCESS_SECRET=dummy_access_secret_min_64_bytes_long_for_test_environment_rapidlifeline_01
JWT_REFRESH_SECRET=dummy_refresh_secret_min_64_bytes_long_for_test_environment_rapidlifeline_02

# Application Settings
PUBLIC_TRACK_BASE_URL=http://localhost:3001/t
SUPPORT_PHONE=+918000000112
PROTOTYPE_LABEL=true

# Third-Party Mock / Prototype Adapters
GOOGLE_MAPS_SERVER_KEY=mock_google_maps_server_key
GOOGLE_MAPS_ANDROID_KEY=mock_google_maps_android_key
GOOGLE_MAPS_IOS_KEY=mock_google_maps_ios_key
GOOGLE_MAPS_WEB_KEY=mock_google_maps_web_key

MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_SENDER_ID=RAPIDL
MSG91_TEMPLATE_OTP=mock_template_otp
MSG91_TEMPLATE_TRACK=mock_template_track
MSG91_TEMPLATE_ALERT=mock_template_alert

EXOTEL_SID=mock_exotel_sid
EXOTEL_API_KEY=mock_exotel_api_key
EXOTEL_API_TOKEN=mock_exotel_api_token
EXOTEL_EXOPHONE=08000000000

RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_razorpay_webhook_secret

FCM_SERVICE_ACCOUNT_JSON={}

AWS_REGION=ap-south-1
S3_DOCUMENTS_BUCKET=rapidlifeline-docs-dev
S3_ASSETS_BUCKET=rapidlifeline-assets-dev

SENTRY_DSN_API=
SENTRY_DSN_MOBILE=
SENTRY_DSN_WEB=

POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
